# App environment. Values below are safe placeholders; fill in real values for staging/production.
NODE_ENV=development                    # development | production
OTP_DELIVERY_MODE=mock                  # "mock" (dev-only log delivery) or "http" (real gateway); see backend README.
DATABASE_URL=""                       # required (Neon URL). Never commit a real database URL.
JWT_SECRET=""                         # required in production, ≥32 chars; stored as a secret.
JWT_EXPIRES_IN_SECONDS="3600"          # optional, default 3600.
CORS_ORIGIN=""                        # required in production (specific frontend origin, not "*").
NEXT_PUBLIC_API_URL="http://localhost:4000"
GEMINI_API_KEY=""

# Rate limits (optional).
LOGIN_RATE_LIMIT_MAX="10"             # login limiter, default 10 / 900000ms.
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
SIGNUP_RATE_LIMIT_MAX="5"            # phone signup, default 5 / 900000ms.
SIGNUP_RATE_LIMIT_WINDOW_MS="900000"
SIGNUP_RESEND_RATE_LIMIT_MAX="3"      # verification-code resend, default 3 / 900000ms.
SIGNUP_RESEND_RATE_LIMIT_WINDOW_MS="900000"
SIGNUP_VERIFY_RATE_LIMIT_MAX="10"    # verification confirm, default 10 / 900000ms.
SIGNUP_VERIFY_RATE_LIMIT_WINDOW_MS="900000"
AI_RATE_LIMIT_MAX="30"
AI_RATE_LIMIT_WINDOW_MS="60000"

# OTP delivery (required for phone signup / verify; production requires URL + TOKEN).
OTP_DELIVERY_URL=""
OTP_DELIVERY_TOKEN=""
OTP_DELIVERY_CHANNEL=""               # optional: "SMS" (default) or "WHATSAPP".
OTP_HASH_SECRET=""                    # optional: falls back to JWT_SECRET (≥32 chars in production).

# Other options.
PREVIEW_TTL_MS="900000"
DASHBOARD_BUSINESS_NAME="My Business"
SEED_PASSWORD=""                      # staging-only; required by `npm run prisma:seed:staging`. Never commit.
