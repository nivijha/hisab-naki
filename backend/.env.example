# Backend environment. Values below are safe placeholders; fill in real values for staging/production.
NODE_ENV=development
OTP_DELIVERY_MODE=mock                 # "mock" logs the OTP in the backend terminal (dev only); "http" uses a real gateway.
OTP_DELIVERY_URL=""                    # http mode only: delivery gateway endpoint (production: HTTPS).
OTP_DELIVERY_TOKEN=""                  # http mode only: bearer token for the delivery gateway.
OTP_DELIVERY_CHANNEL=""                # optional: "SMS" (default) or "WHATSAPP".
OTP_HASH_SECRET=""                     # optional: HMAC secret for OTP codes; falls back to JWT_SECRET (≥32 chars in production).

PROTOTYPE_SIGNUP_ENABLED=""            # "true"/"1" enables POST /api/auth/signup (MVP password signup); rejected in production.
PROTOTYPE_SIGNUP_RATE_LIMIT_MAX="5"    # prototype signup limiter, default 5 / 900000ms.
PROTOTYPE_SIGNUP_RATE_LIMIT_WINDOW_MS="900000"

# Shared vars are documented in the root .env.example; required in production: DATABASE_URL, JWT_SECRET, CORS_ORIGIN.

# Cookie session auth (browser flow)
SESSION_COOKIE_SECURE=""               # default: true in production, false otherwise
SESSION_COOKIE_SAMESITE="lax"          # lax|strict|none (none requires Secure)
SESSION_COOKIE_DOMAIN=""               # optional, set when frontend/backend share parent domain
